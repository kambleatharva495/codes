CREATE TABLE O_RollCall
(
    roll_no INT,
    name VARCHAR(20),
    address VARCHAR(20)
);

CREATE TABLE N_RollCall
(
    roll_no INT,
    name VARCHAR(20),
    address VARCHAR(20)
);


DELIMITER //

CREATE PROCEDURE p3(IN r1 INT)
BEGIN
    DECLARE r2 INT;
    DECLARE exit_loop BOOLEAN DEFAULT FALSE;

    DECLARE c1 CURSOR FOR
    SELECT roll_no
    FROM O_RollCall
    WHERE roll_no > r1;

    DECLARE CONTINUE HANDLER FOR NOT FOUND
    SET exit_loop = TRUE;

    OPEN c1;

    e_loop: LOOP

        FETCH c1 INTO r2;

        IF exit_loop THEN
            CLOSE c1;
            LEAVE e_loop;
        END IF;

        IF NOT EXISTS
        (
            SELECT *
            FROM N_RollCall
            WHERE roll_no = r2
        )
        THEN
            INSERT INTO N_RollCall
            SELECT *
            FROM O_RollCall
            WHERE roll_no = r2;
        END IF;

    END LOOP e_loop;

END //

DELIMITER ;
CALL p3(3);


SELECT * FROM N_RollCall;



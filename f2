<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Responsive Multi-Column Layout</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">
</head>
<body>

    <div class="container py-5">
        <h1 class="text-center mb-5">Responsive Multi-Column Layout</h1>

        <div class="row g-4">
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card p-4 shadow-sm h-100">
                    <h3>Column 1</h3>
                    <p>Responsive Bootstrap grid content.</p>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card p-4 shadow-sm h-100">
                    <h3>Column 2</h3>
                    <p>Layout changes according to screen size.</p>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card p-4 shadow-sm h-100">
                    <h3>Column 3</h3>
                    <p>Responsive design without extensive custom CSS.</p>
                </div>
            </div>
        </div>
    </div>

    <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>